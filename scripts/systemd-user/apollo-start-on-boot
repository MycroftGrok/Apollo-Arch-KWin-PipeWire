#!/bin/sh
set -eu

CONFIG_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/sunshine/sunshine.conf"

setting_value() {
  [ -f "$CONFIG_FILE" ] || return 0

  sed -nE \
    's/^[[:space:]]*start_on_boot[[:space:]]*=[[:space:]]*([^#]*).*$/\1/p' \
    "$CONFIG_FILE" \
    | tail -n 1 \
    | tr '[:upper:]' '[:lower:]' \
    | tr -d '"[:space:]'
}

is_enabled() {
  value="$(setting_value || true)"

  case "$value" in
    0|false|no|off|disable|disabled)
      return 1
      ;;
    *)
      # A missing setting is intentionally enabled by default.
      return 0
      ;;
  esac
}

case "${1:-}" in
  enabled)
    is_enabled
    ;;

  run)
    if ! is_enabled; then
      echo "Apollo automatic startup is disabled."
      exit 0
    fi

    if systemctl --user is-active --quiet apollo.service; then
      echo "Apollo is already running."
      exit 0
    fi

    echo "Starting Apollo because start_on_boot is enabled."
    exec systemctl --user start apollo.service
    ;;

  status)
    if is_enabled; then
      echo "Apollo start with OS setting: enabled"
    else
      echo "Apollo start with OS setting: disabled"
    fi

    if systemctl --user is-enabled --quiet apollo-start-on-boot.service; then
      echo "Apollo startup policy service: enabled"
    else
      echo "Apollo startup policy service: disabled"
    fi

    if systemctl --user is-enabled --quiet apollo.service; then
      echo "Direct Apollo service autostart: enabled"
    else
      echo "Direct Apollo service autostart: disabled (managed by startup policy)"
    fi
    ;;

  *)
    echo "Usage: $0 enabled|run|status" >&2
    exit 2
    ;;
esac
