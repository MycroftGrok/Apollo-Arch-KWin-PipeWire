#!/bin/sh
set -eu

ENV_FILE="$HOME/.config/apollo/kwin-virtual-monitor.env"
[ -f "$ENV_FILE" ] && . "$ENV_FILE"

TARGET="${APOLLO_KWIN_OUTPUT_NAME:-Virtual-Apollo-Display}"
HELPER="/usr/local/bin/apollo-kscreen-stream-monitors"

case "${1:-}" in
  connect)
    exec "$HELPER" apply "$TARGET"
    ;;
  disconnect)
    systemd-run --user --collect --quiet -- \
      "$HELPER" post-disconnect >/dev/null 2>&1 || true
    ;;
  configure)
    WIDTH="${2:-}"
    HEIGHT="${3:-}"
    REFRESH_MHZ="${4:-60000}"
    if [ -z "$WIDTH" ] || [ -z "$HEIGHT" ] || [ -z "$REFRESH_MHZ" ]; then
      echo "Usage: $0 configure WIDTH HEIGHT REFRESH_MHZ" >&2
      exit 2
    fi
    exec "$HELPER" configure "$TARGET" "$WIDTH" "$HEIGHT" "$REFRESH_MHZ"
    ;;
  restore)
    exec "$HELPER" restore
    ;;
  status)
    exec "$HELPER" status
    ;;
  *)
    echo "Usage: $0 connect|disconnect|configure WIDTH HEIGHT REFRESH_MHZ|restore|status" >&2
    exit 2
    ;;
esac
