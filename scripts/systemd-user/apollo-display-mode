#!/bin/sh
set -eu

ENV_FILE="$HOME/.config/apollo/kwin-virtual-monitor.env"
[ -f "$ENV_FILE" ] && . "$ENV_FILE"

TARGET="${APOLLO_KWIN_OUTPUT_NAME:-Virtual-Apollo-Display}"
HELPER="/usr/local/bin/apollo-kscreen-stream-monitors"

case "${1:-}" in
  connect)
    exec "$HELPER" apply "$TARGET"
    ;;
  disconnect)
    systemd-run --user --collect --quiet -- \
      "$HELPER" post-disconnect >/dev/null 2>&1 || true
    ;;
  configure)
    # The archived display-state helper does not resize the persistent monitor.
    # Apollo is already using the configured fixed KWin virtual-display mode.
    exit 0
    ;;
  restore)
    exec "$HELPER" restore
    ;;
  status)
    exec "$HELPER" status
    ;;
  *)
    echo "Usage: $0 connect|disconnect|configure [WIDTH HEIGHT]|restore|status" >&2
    exit 2
    ;;
esac
